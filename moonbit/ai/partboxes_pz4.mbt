///|
pub(all) struct PartBox {
  zone : String // z
  armor : Double
  px : String // p: 所属空间("root"|"turret"|"gun")
  cx : Double // c[0]
  cy : Double // c[1]
  cz : Double // c[2]
  qx : Double // q[0](四元数, 缺失 0/0/0/0)
  qy : Double // q[1]
  qz : Double // q[2]
  qw : Double // q[3]
  hx : Double // h[0]
  hy : Double // h[1]
  hz : Double // h[2]
}

///|
