// traceai — 黄金轨迹比对器(main 包): 读 fixtures/golden/ai.json, 按 SPEC.md 重放
// ai 直译实现(SF.AI + sim-engine 数值子集)并逐 snapshot 逐字段比对(输出约定同 tracecheck)。
// 全过打印 "TRACE OK ai N/N" 退出 0; 失败打印首个 mismatch(fixture/snapshot/tick/字段/期望/实际)退出 1。
pkgtype(kind: "executable")

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/math",
  "lb091188/steel-moonbit/simcore",
  "lb091188/steel-moonbit/ai",
}
