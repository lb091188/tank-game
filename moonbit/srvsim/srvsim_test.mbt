// (acos 特殊: V8 的 Math.acos 与 fdlibm 3.5%、与 glibc 7.6% 的输入上差 1ulp, 无公开可移植
//  逐位实现; 本实现取 fdlibm 移植 —— srvsim 链内单调用点(判伤入射角 eff), 黄金轨迹全程不敏感。
//  故 acos 不做逐位表, 改为锚点容差断言。)

///|
fn check_vec(
  name : String,
  table : Array[(UInt64, UInt64, UInt64)],
  f : (Double, Double) -> Double,
) -> Unit {
  for i, e in table {
    let got = f(d_of_bits(e.0), d_of_bits(e.1))
    if got.reinterpret_as_uint64() != e.2 {
      abort("v8 \{name}[\{i}] 位型不一致: got=\{got} expect_bits=\{e.2}")
    }
  }
}

///|
test "v8 math kernels match node bit-for-bit" {
  check_vec("sin", v8_sin_ref, fn(a, _b) { v8_sin(a) })
  check_vec("cos", v8_cos_ref, fn(a, _b) { v8_cos(a) })
  check_vec("atan2", v8_atan2_ref, fn(a, b) { v8_atan2(a, b) })
  check_vec("asin", v8_asin_ref, fn(a, _b) { v8_asin(a) })
  check_vec("exp", v8_exp_ref, fn(a, _b) { v8_exp(a) })
  check_vec("hypot", v8_hypot_ref, fn(a, b) { @math.hypot(a, b) })
}

///|
// ---- acos 锚点(容差断言; 见上方说明) ----
test "acos anchor within tolerance of V8" {
  // node: Math.acos(0.9670262702171577) = 0.25751330607337186(本实现差 1ulp)
  let a = v8_acos(0.9670262702171577)
  assert_eq((a - 0.25751330607337186).abs() <= 1.0e-16, true)
  // node: Math.acos(0.2905210150211013) = 1.2760250339548311
  let b = v8_acos(0.2905210150211013)
  assert_eq((b - 1.2760250339548311).abs() <= 1.0e-15, true)
}

///|
// ---- Math.round 精确语义(含 0.49999999999999994 这类 floor(x+0.5) 陷阱输入) ----
test "js_round matches JS Math.round" {
  assert_eq(js_round(2.5), 3.0)
  assert_eq(js_round(-2.5), -2.0)
  assert_eq(js_round(d_of_bits(0x3FDFFFFFFFFFFFFFUL)), 0.0) // 0.49999999999999994(V8 规范答案 0)
  assert_eq(js_round(137.5), 138.0)
  assert_eq(js_round(-0.5), -0.0)
  assert_eq(js_round(30.0), 30.0)
  assert_eq(js_round(29.983333333333334), 30.0)
}

///|
// ---- toFixed 数值还原(JS +v.toFixed(n) 精确语义; 含 -0、<0.0005 小值与平手向 +∞) ----
test "to_fixed matches JS toFixed" {
  assert_eq(to_fixed(-0.000023491320863056976, 3), 0.0) // "-0.000" → -0, 与 +0 数值相等
  assert_eq(to_fixed(-268.466875173176, 1), -268.5)
  assert_eq(to_fixed(2.11, 2), 2.11)
  assert_eq(to_fixed(-0.02597940068444391, 2), -0.03)
  assert_eq(to_fixed(0.038, 3), 0.038)
  assert_eq(to_fixed(1400.0, 1), 1400.0)
  assert_eq(to_fixed(29.983333333333334, 0), 30.0)
  assert_eq(to_fixed(4.15, 1), 4.2)
  // 平手取较大 n(toward +∞): (-1.25).toFixed(1) = "-1.2"
  assert_eq(to_fixed(-1.25, 1), -1.2)
  assert_eq(to_fixed(1.25, 1), 1.3)
}

///|
// ---- makeTank 字段接线(pz4 / 弹夹车 batchat / 固定战斗室 stug3) ----
test "make_tank spec wiring" {
  let t = make_tank(
    { id: 1, name: "red-1", tank: "pz4", team: 0, },
    10.0,
    20.0,
    0.5,
  )
  assert_eq(t.spec.typ, "pz4")
  assert_eq(t.hp, 720.0)
  assert_eq(t.net_id, 1)
  assert_eq(t.team, 0)
  assert_eq(t.gear, "D1")
  assert_eq(t.clip_phase, "single")
  assert_eq(t.reload_t, 1.0)
  assert_eq(t.disp, 2.4)
  assert_eq(t.no_turret, false)
  let t2 = make_tank(
    { id: 2, name: "b", tank: "batchat", team: 1, },
    0.0,
    0.0,
    0.0,
  )
  assert_eq(t2.clip_left, 5) // gun.autoloader.clip
  assert_eq(t2.clip_phase, "intra")
  let t3 = make_tank(
    { id: 3, name: "c", tank: "stug3", team: 1, },
    0.0,
    0.0,
    0.0,
  )
  assert_eq(t3.no_turret, true) // spec.gunArc !== undefined
}

///|
// ---- clampInput(srv-sim.js:228-238): 油门/舵钳 [-1,1], 瞄准角归一, 俯仰钳射界 ----
test "clamp_input clamps to spec" {
  let t = make_tank({ id: 1, name: "r", tank: "pz4", team: 0, }, 0.0, 0.0, 0.0)
  let i = clamp_input(t, {
    throttle: Some(5.0),
    steer: Some(-3.0),
    aim_yaw: Some(7.0),
    aim_pitch: Some(99.0),
    fire: Some(true),
  })
  assert_eq(i.throttle, 1.0)
  assert_eq(i.steer, -1.0)
  assert_eq(i.aim_pitch, t.spec.gun_elevation)
  assert_eq(i.aim_yaw, 0.7168146928204135) // node: Math.atan2(Math.sin(7), Math.cos(7))
  assert_eq(i.fire, true)
}

///|
// ---- 房间出生池洗牌(房间独立 mulberry32(777) 流, SPEC §4) ----
test "seeded shuffle permutes via room rng" {
  let rng = @simcore.Mulberry32::new(777)
  let arr : Array[(Double, Double)] = [
    (1.0, 1.0),
    (2.0, 2.0),
    (3.0, 3.0),
    (4.0, 4.0),
  ]
  let s = seeded_shuffle(arr, rng)
  assert_eq(s.length(), 4)
  let mut sum = 0.0
  for e in s {
    sum += e.0
  }
  assert_eq(sum, 10.0) // 置换
}

///|
// ---- 判伤结算(srv-sim.js:128-158): 入射 0° hullRear 必穿透, hp 落在 dmg 变异带内 ----
test "judge on_hit_tank applies pen damage" {
  let heights : FixedArray[Float] = FixedArray::make(288 * 288, 0.0)
  let room = Room::create({
    heights,
    terrain_size: 1000.0,
    terrain_res: 288,
    covers_raw: [],
    seed: 777,
    time_limit: 30.0,
    players: [
      { id: 1, name: "a", tank: "pz4", team: 0, },
      { id: 2, name: "b", tank: "pz4", team: 1, },
    ],
    coop: false,
    waves: [],
    repair_duration: 12.0,
    repair_hp_ratio: 0.35,
    on_event: fn(_k, _e) { () },
    on_end: fn(_rows) { () },
  })
  rng_boot(20261009)
  let sh : Shell = {
    active: true,
    owner: room.tanks.get(1).unwrap(),
    team: 0,
    px: 0.0,
    py: 0.0,
    pz: 0.0,
    vx: 0.0,
    vy: 0.0,
    vz: 0.0,
    pen: 200.0,
    dmg: 110.0,
    cal: 75.0,
    life: 4.0,
    warned: false,
    grav: 3.2,
    splash: 0.0,
  }
  let tk = room.tanks.get(2).unwrap()
  let hit : HitRec = {
    distance: 10.0,
    point: { x: 0.0, y: 1.0, z: 0.0, },
    normal: { x: 0.0, y: 0.0, z: -1.0, }, // 面法线逆弹向 → 入射角 0(不跳弹)
    zone: "hullRear",
    armor: 40.0,
  }
  room.judge.on_hit_tank(sh, tk, hit, { x: 0.0, y: 0.0, z: 1.0, })
  // pen 200×(1±0.25) ≥ eff(40/cos0 = 40) → 必穿; dmg 110×(1±0.25) ∈ [82.5, 137.5]
  assert_eq(tk.hp < 720.0, true)
  assert_eq(tk.hp > 500.0, true)
}
